# StormPulse — variáveis de ambiente (FASE 1).
# Copie para `.env` e ajuste. NUNCA commite o `.env` real.
# Segredos (senhas, chaves) devem existir SOMENTE aqui / no ambiente.

# --- App ---
APP_NAME=StormPulse
ENVIRONMENT=local           # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- API ---
API_PORT=8000
# Timeout de cada checagem individual (Postgres/Redis) no GET /ready.
READINESS_TIMEOUT_SECONDS=2.0

# --- Observabilidade (OpenTelemetry, FASE 14 / ADR-0035) ---
# Desligar (false) evita a thread de exportação de métricas/tracing —
# raramente necessário, só em cenários muito restritos de recursos.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=stormpulse-backend
# Vazio = exporta só pro console (sempre visível via `docker compose logs`,
# sem infra externa). Preencha com um endpoint OTLP/HTTP real (Grafana
# Tempo, Jaeger, etc.) quando um coletor existir.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- PostgreSQL + PostGIS ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Bootstrap/superuser role (Docker's POSTGRES_USER) — usado só pra rodar
# migração (Alembic). Nunca é a conexão de runtime da API/workers desde
# a RLS (FASE 34, migração 0b7b9a5dbd11): um superusuário do Postgres
# ignora row-level security mesmo com FORCE ROW LEVEL SECURITY.
POSTGRES_USER=stormpulse
POSTGRES_PASSWORD=stormpulse   # troque em qualquer ambiente compartilhado
POSTGRES_DB=stormpulse
# Role restrita (sem superusuário) que a API e os workers passam a usar
# de verdade — a migração de RLS cria essa role e concede só DML nas
# tabelas. O NOME não é configurável (fixo em POSTGRES_APP_ROLE,
# backend/app/core/config.py — a migração de RLS sempre cria exatamente
# "stormpulse_app"; um POSTGRES_APP_USER diferente já foi uma
# "configurabilidade" só de mentirinha que quebrava o deploy em silêncio).
# Só a SENHA varia por ambiente — TROCA obrigatória em produção: o valor
# padrão é recusado no startup quando ENVIRONMENT=production (ver
# Settings._forbid_dev_secret_in_production).
POSTGRES_APP_PASSWORD=stormpulse_app

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Segurança / JWT (FASE 3) ---
# Em produção é OBRIGATÓRIO definir um segredo forte (>= 32 bytes).
# O valor de desenvolvimento abaixo é recusado quando ENVIRONMENT=production.
JWT_SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting dos endpoints de autenticação (janela fixa).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Criptografia de dados do usuário em repouso (FASE 34, ADR-0055) ---
# email/full_name/google_sub de `users` (e os snapshots de e-mail em
# admin_audit_log) ficam criptografados no banco (AES-256-GCM). As duas
# chaves abaixo são valores base64 de 32 bytes brutos, e PRECISAM ser
# fortes e DIFERENTES entre si em produção — os valores de desenvolvimento
# abaixo são recusados quando ENVIRONMENT=production (mesmo padrão do
# JWT_SECRET_KEY). Gere cada uma com: openssl rand -base64 32
# Trocar a chave depois de já existirem dados criptografados torna esses
# dados irrecuperáveis — guarde-a com o mesmo cuidado de um backup de banco.
FIELD_ENCRYPTION_KEY=ZGV2LWluc2VjdXJlLWVuY3J5cHRpb24ta2V5LTMyYmI=
FIELD_ENCRYPTION_INDEX_KEY=ZGV2LWluc2VjdXJlLWJsaW5kLWluZGV4LWtleS0zMmI=

# --- CORS (dashboard web / app mobile) ---
# Origens separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Cookie de refresh token (ADR-0029, completado na Fase 4 do
# hardening — ADR-0045) ---
# Ligado por padrão: com HTTPS + mesma origem já em produção (ADR-0038/0039),
# o bloqueio original do ADR-0029 (decisão de domínio pendente) está
# resolvido. O dashboard web agora depende deste modo — refresh_token nunca
# mais vai pro corpo JSON nem pro localStorage. O app mobile continua com o
# fluxo antigo (token no corpo, guardado em SecureStore), sem mudança.
REFRESH_COOKIE_ENABLED=true
REFRESH_COOKIE_NAME=stormpulse_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=true
# strict | lax | none — "none" exige REFRESH_COOKIE_SECURE=true (regra do
# navegador) e é só pra deploy cross-site (frontend/API em domínios diferentes).
REFRESH_COOKIE_SAMESITE=lax
# Deixe em branco (cookie "host-only") num deploy same-origin. Só defina um
# domínio real quando existir um (ex: .stormpulse.com para compartilhar entre
# subdomínios).
REFRESH_COOKIE_DOMAIN=

# --- Login com Google ---
# Crie em https://console.cloud.google.com/apis/credentials — tipo "Web
# application", com http://localhost:5173 nas origens JavaScript autorizadas.
# Sem client_id, o botão "Sign in with Google" simplesmente não aparece.
GOOGLE_CLIENT_ID=

# --- Painel de operador da plataforma (FASE 28, ADR-0048) ---
# E-mail de uma conta JÁ CADASTRADA que deve virar operador da plataforma
# (visão cross-tenant, /api/v1/admin/*) — promovido automaticamente a cada
# subida da API. Nunca cria a conta, só promove uma que já existe.
PLATFORM_ADMIN_EMAIL=

# --- Rate limiting geral e do modo visitante (FASE 14/15) ---
DEFAULT_RATE_LIMIT_MAX=120
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=60
# Balde ÚNICO compartilhado por todo cliente anônimo atrás do mesmo IP — em
# produção isso normalmente não é "um visitante", é CGNAT de operadora móvel
# (muito comum no Brasil, público deste app): várias pessoas sem relação
# nenhuma dividem o mesmo IP público. O valor 30 original já era estourado
# por uma única aba de visitante sozinha (VisitorView faz polling de 5
# desses endpoints juntos a cada 30s, ~10 req/min só parado) — bug real
# reportado em produção (FASE 34), corrigido subindo pra bater com
# DEFAULT_RATE_LIMIT_MAX.
PUBLIC_RATE_LIMIT_MAX=120
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
# Hardening ADR-0033: vazio por padrão = nenhum proxy é confiável, o limiter
# sempre usa o IP do peer TCP direto (correto sem proxy reverso na frente).
# Com o nginx do infra/docker-compose.prod.yml na frente (mesma origem,
# IP fixo 172.28.0.10 no compose), produção define TRUSTED_PROXY_IPS=172.28.0.10
# — ver infra/README.md. Confiar cegamente em Forwarded/X-Forwarded-For sem
# isso permite que qualquer cliente falsifique esses cabeçalhos.
TRUSTED_PROXY_IPS=

# --- Fonte meteorológica (FASE 5 / FASE 13 / FASE 17) ---
# "mock" (dados SIMULADOS), "inmet" (real, estações automáticas do INMET) ou
# "cptec" (real, previsão do INPE/CPTEC).
WEATHER_PROVIDER=mock

# --- INMET (FASE 13) — só usado quando WEATHER_PROVIDER=inmet ---
# Endpoints públicos, sem token para o que o pipeline consome (dados horários).
INMET_BASE_URL=https://apitempo.inmet.gov.br
INMET_AVISOS_URL=https://apiprevmet3.inmet.gov.br
# Reservado para uso futuro (endpoint tokenizado de dados quase em tempo real).
INMET_API_TOKEN=
INMET_HTTP_TIMEOUT_SECONDS=10
INMET_MIN_RAIN_RATE_MM_H=4.0
INMET_MAX_STATION_DISTANCE_KM=100.0
# Previsão (FASE 15) — 5 dias reais + 1 histórico via resolução de geocódigo IBGE.
INMET_PREVISAO_URL=https://apiprevmet3.inmet.gov.br
IBGE_LOCALIDADES_URL=https://servicodados.ibge.gov.br/api/v1/localidades

# --- INPE/CPTEC — previsão de redundância (FASE 17) ---
# Público, sem chave, aceita lat/lon direto (sem geocódigo). Usado como
# fallback automático quando WEATHER_PROVIDER=inmet e o INMET falha — ou
# como fonte principal isolada com WEATHER_PROVIDER=cptec.
CPTEC_BASE_URL=https://servicos.cptec.inpe.br/XML
CPTEC_HTTP_TIMEOUT_SECONDS=10
CPTEC_FALLBACK_ENABLED=true

# --- Open-Meteo — terceiro nível de redundância (FASE 20) ---
# Público, sem chave. Gratuito só para uso NÃO comercial e até 10.000
# chamadas/dia (StormPulse fica bem abaixo disso). Único dos 3 provedores
# que dá previsão numérica real de chuva (probabilidade + mm) — INMET e
# CPTEC não conseguem. Fallback automático: INMET -> CPTEC -> Open-Meteo.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_HTTP_TIMEOUT_SECONDS=10
OPEN_METEO_FALLBACK_ENABLED=true

# --- Observação via satélite (GOES-19 + TATHU, FASE 16) ---
# Desligado por padrão: custo real de infra (GDAL, ~20-30MB/ciclo de 10min).
SATELLITE_ENABLED=false
# Hardening ADR-0032: a imagem Docker também tem duas variantes — a padrão
# (runtime-base) não traz GDAL/TATHU. Só mude para runtime-satellite junto
# com SATELLITE_ENABLED=true acima (docker-compose.yml, serviços api/worker).
API_DOCKER_TARGET=runtime-base
SATELLITE_STAC_URL=https://data.inpe.br/bdc/stac/v1
SATELLITE_COLLECTION=GOES19-L2-CMI-1
SATELLITE_BAND=B13
# Bounding box do Brasil: lon_min,lat_min,lon_max,lat_max.
SATELLITE_EXTENT=-74,-34,-34,6
SATELLITE_THRESHOLD_KELVIN=230.0
SATELLITE_MIN_AREA_KM2=3000.0
SATELLITE_GRID_RESOLUTION_KM=4.0
SATELLITE_MAX_WATCH_AGE_HOURS=3.0

# --- Boletins oficiais (item 3, ADR-0064) ---
# Reusa WeatherProvider.get_warnings (INMET /avisos/ativos) já existente —
# única fonte nacional pública, sem cadastro, de alertas meteorológicos
# oficiais. Ligado por padrão, sem custo de infra novo.
OFFICIAL_WARNINGS_ENABLED=true

# --- Sinais agronômicos (FASE 19) ---
# Ligado por padrão: reusa forecast/rainfall/current-data já existentes,
# sem custo de infra novo. Limiares são referências agronômicas genéricas,
# não específicas por cultura — ver ADR-0014.
AGRO_ENABLED=true
AGRO_FROST_THRESHOLD_C=3.0
# Camada mais leve/de aviso antecipado — qualquer dia igual ou abaixo deste
# valor (mas acima do severo) sai como "risco leve", nunca misturado
# silenciosamente no aviso severo (ver ADR-0018).
AGRO_FROST_LIGHT_THRESHOLD_C=6.0
AGRO_DRY_SPELL_WINDOW_DAYS=15
AGRO_DRY_SPELL_MIN_DAYS=7
AGRO_DRY_SPELL_RAIN_THRESHOLD_MM=1.0
AGRO_SPRAY_MAX_WIND_KMH=15.0
# Só pesa quando a fonte ativa dá previsão numérica de chuva (Open-Meteo,
# FASE 20) — INMET/CPTEC deixam em branco, então isso simplesmente não
# desqualifica a janela quando a fonte não sabe dizer.
AGRO_SPRAY_MAX_RAIN_PROBABILITY_PERCENT=30
# Assinatura de inversão térmica (vento calmo + umidade alta, clássico ao
# amanhecer) — só pesa quando a fonte ativa dá umidade (Open-Meteo/INMET).
AGRO_SPRAY_INVERSION_MAX_WIND_KMH=3.0
AGRO_SPRAY_INVERSION_MIN_HUMIDITY_PERCENT=90.0

# --- NDVI por talhão (Copernicus Sentinel Hub, FASE 29) ---
# Desligado por padrão: exige credenciais próprias (client_id/secret OAuth2
# da Copernicus Data Space Ecosystem — crie uma conta grátis em
# https://dataspace.copernicus.eu/ e um "OAuth client" no painel) e
# consome cota mensal compartilhada da conta. Só se aplica a talhões
# (locais com contorno desenhado) — uma fazenda-ponto não tem polígono
# pra calcular NDVI sobre.
NDVI_ENABLED=false
NDVI_SH_CLIENT_ID=
NDVI_SH_CLIENT_SECRET=
NDVI_LOOKBACK_DAYS=15.0

# --- Notificação push real (Web Push / VAPID, FASE 22) ---
# Sem serviço externo (FCM/APNs) — gere o par de chaves uma vez, localmente:
#   python -c "
#   import base64
#   from py_vapid import Vapid
#   from cryptography.hazmat.primitives import serialization
#   v = Vapid(); v.generate_keys()
#   priv = v.private_key.private_numbers().private_value.to_bytes(32, 'big')
#   pub = v.public_key.public_bytes(
#       serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
#   b64 = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()
#   print('VAPID_PRIVATE_KEY=' + b64(priv))
#   print('VAPID_PUBLIC_KEY=' + b64(pub))
#   "
# VAPID_PUBLIC_KEY também precisa ir pro frontend, mas por um caminho
# DIFERENTE deste .env: web/src/push.ts lê VITE_VAPID_PUBLIC_KEY, que o
# Vite embute no bundle JS já no BUILD (não em runtime) — não existe jeito
# do servidor "passar" esse valor pro frontend depois de já buildado. Em
# dev, web/.env.local. Em produção, o Dockerfile do web/ recebe via
# `ARG VITE_VAPID_PUBLIC_KEY` (ver web/Dockerfile), passado pelo workflow
# de CI a partir da variável de repositório do GitHub Actions do mesmo
# nome (`gh variable set VITE_VAPID_PUBLIC_KEY --repo ... --body '<chave
# pública>'`) — não é segredo (é enviada a cada visitante do navegador do
# mesmo jeito), mas tem que ser exatamente a mesma chave do
# VAPID_PRIVATE_KEY abaixo, senão a assinatura da inscrição nunca bate.
# Sem chave configurada em nenhum dos dois lados, notificações ficam
# SUPPRESSED no backend (nunca fingem enviar) e o botão "Ativar
# notificações" falha no frontend com um erro explícito, não silencioso.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:contato@stormpulse.example

# --- Ciclo de conta: e-mail transacional (AWS SES) e anti-abuso (hCaptcha), FASE 8 ---
# E-mail de verificação de conta e de redefinição de senha. Credenciais da
# AWS NUNCA vão aqui — vêm só de AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY no
# ambiente, ou da IAM role da própria instância em produção (mesmo
# princípio já usado pro backup em S3, ver infra/backup-postgres.sh).
# SES_FROM_EMAIL precisa ser um remetente já verificado na sua conta SES
# (ou o domínio inteiro, via DKIM) — sem isso, o envio é pulado (logado,
# nunca falha a requisição que disparou o e-mail).
AWS_REGION=us-east-1
SES_FROM_EMAIL=
# Base pública do frontend, só para montar os links dos e-mails acima
# (ex.: https://app.stormpulse.example).
FRONTEND_BASE_URL=http://localhost:5173

# Cadastro gratuito em https://www.hcaptcha.com/ — cria um "site" e copia o
# par site key e secret key. A secret key vai só aqui (nunca no frontend);
# a site key é pública e vai pro build do frontend via
# VITE_HCAPTCHA_SITE_KEY (web/.env.local em dev; em produção, variável de
# repositório VITE_HCAPTCHA_SITE_KEY do GitHub Actions, mesmo caminho já
# usado pra VITE_VAPID_PUBLIC_KEY — ver web/Dockerfile e ci.yml). Sem
# HCAPTCHA_SECRET_KEY configurada aqui, /auth/register e /auth/login não
# exigem captcha (dev/test).
HCAPTCHA_SECRET_KEY=

# --- Resumo de risco por IA (Claude, FASE 9) ---
# Crie uma chave em https://console.anthropic.com/settings/keys. Sem
# ANTHROPIC_API_KEY configurada, storm_risks.ai_summary fica sempre NULL
# e o dashboard simplesmente não mostra aquela linha de texto — nunca
# finge. O modelo (Haiku) é fixo no código, não configurável aqui: é um
# resumo curto e determinístico de números já calculados pelo motor de
# risco, não justifica um modelo mais caro. Só gera resumo para risco
# amarelo/laranja/vermelho (verde não tem o que explicar).
ANTHROPIC_API_KEY=

# --- Raios / descargas atmosféricas (API-REDEMET STSC, FASE 23) ---
# Cadastro gratuito em https://api-redemet.decea.mil.br/cadastro-api/ —
# nome, e-mail, motivo de uso. Sem custo, mesma linha dos outros provedores
# públicos (INMET/CPTEC). Off por padrão.
LIGHTNING_ENABLED=false
REDEMET_API_KEY=
REDEMET_BASE_URL=https://api-redemet.decea.mil.br
LIGHTNING_HTTP_TIMEOUT_SECONDS=15.0
# Quanto tempo um raio detectado continua aparecendo no mapa antes de ser
# considerado obsoleto e removido — retrato do "agora", não histórico.
LIGHTNING_RETENTION_MINUTES=30.0
