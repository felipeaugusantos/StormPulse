# StormPulse — variáveis de ambiente (FASE 1).
# Copie para `.env` e ajuste. NUNCA commite o `.env` real.
# Segredos (senhas, chaves) devem existir SOMENTE aqui / no ambiente.

# --- App ---
ENVIRONMENT=local           # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- API ---
API_PORT=8000

# --- PostgreSQL + PostGIS ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=stormpulse
POSTGRES_PASSWORD=stormpulse   # troque em qualquer ambiente compartilhado
POSTGRES_DB=stormpulse

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Segurança / JWT (FASE 3) ---
# Em produção é OBRIGATÓRIO definir um segredo forte (>= 32 bytes).
# O valor de desenvolvimento abaixo é recusado quando ENVIRONMENT=production.
JWT_SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting dos endpoints de autenticação (janela fixa).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- CORS (dashboard web / app mobile) ---
# Origens separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Login com Google ---
# Crie em https://console.cloud.google.com/apis/credentials — tipo "Web
# application", com http://localhost:5173 nas origens JavaScript autorizadas.
# Sem client_id, o botão "Sign in with Google" simplesmente não aparece.
GOOGLE_CLIENT_ID=

# --- Rate limiting geral e do modo visitante (FASE 14/15) ---
DEFAULT_RATE_LIMIT_MAX=120
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_MAX=30
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60

# --- Fonte meteorológica (FASE 5 / FASE 13 / FASE 17) ---
# "mock" (dados SIMULADOS), "inmet" (real, estações automáticas do INMET) ou
# "cptec" (real, previsão do INPE/CPTEC).
WEATHER_PROVIDER=mock

# --- INMET (FASE 13) — só usado quando WEATHER_PROVIDER=inmet ---
# Endpoints públicos, sem token para o que o pipeline consome (dados horários).
INMET_BASE_URL=https://apitempo.inmet.gov.br
INMET_AVISOS_URL=https://apiprevmet3.inmet.gov.br
# Reservado para uso futuro (endpoint tokenizado de dados quase em tempo real).
INMET_API_TOKEN=
INMET_HTTP_TIMEOUT_SECONDS=10
INMET_MIN_RAIN_RATE_MM_H=4.0
INMET_MAX_STATION_DISTANCE_KM=100.0
# Previsão (FASE 15) — 5 dias reais + 1 histórico via resolução de geocódigo IBGE.
INMET_PREVISAO_URL=https://apiprevmet3.inmet.gov.br
IBGE_LOCALIDADES_URL=https://servicodados.ibge.gov.br/api/v1/localidades

# --- INPE/CPTEC — previsão de redundância (FASE 17) ---
# Público, sem chave, aceita lat/lon direto (sem geocódigo). Usado como
# fallback automático quando WEATHER_PROVIDER=inmet e o INMET falha — ou
# como fonte principal isolada com WEATHER_PROVIDER=cptec.
CPTEC_BASE_URL=https://servicos.cptec.inpe.br/XML
CPTEC_HTTP_TIMEOUT_SECONDS=10
CPTEC_FALLBACK_ENABLED=true

# --- Open-Meteo — terceiro nível de redundância (FASE 20) ---
# Público, sem chave. Gratuito só para uso NÃO comercial e até 10.000
# chamadas/dia (StormPulse fica bem abaixo disso). Único dos 3 provedores
# que dá previsão numérica real de chuva (probabilidade + mm) — INMET e
# CPTEC não conseguem. Fallback automático: INMET -> CPTEC -> Open-Meteo.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_HTTP_TIMEOUT_SECONDS=10
OPEN_METEO_FALLBACK_ENABLED=true

# --- Observação via satélite (GOES-19 + TATHU, FASE 16) ---
# Desligado por padrão: custo real de infra (GDAL, ~20-30MB/ciclo de 10min).
SATELLITE_ENABLED=false
SATELLITE_STAC_URL=https://data.inpe.br/bdc/stac/v1
SATELLITE_COLLECTION=GOES19-L2-CMI-1
SATELLITE_BAND=B13
# Bounding box do Brasil: lon_min,lat_min,lon_max,lat_max.
SATELLITE_EXTENT=-74,-34,-34,6
SATELLITE_THRESHOLD_KELVIN=230.0
SATELLITE_MIN_AREA_KM2=3000.0
SATELLITE_GRID_RESOLUTION_KM=4.0
SATELLITE_MAX_WATCH_AGE_HOURS=3.0

# --- Sinais agronômicos (FASE 19) ---
# Ligado por padrão: reusa forecast/rainfall/current-data já existentes,
# sem custo de infra novo. Limiares são referências agronômicas genéricas,
# não específicas por cultura — ver ADR-0014.
AGRO_ENABLED=true
AGRO_FROST_THRESHOLD_C=3.0
AGRO_DRY_SPELL_WINDOW_DAYS=15
AGRO_DRY_SPELL_MIN_DAYS=7
AGRO_DRY_SPELL_RAIN_THRESHOLD_MM=1.0
AGRO_SPRAY_MAX_WIND_KMH=15.0
# Só pesa quando a fonte ativa dá previsão numérica de chuva (Open-Meteo,
# FASE 20) — INMET/CPTEC deixam em branco, então isso simplesmente não
# desqualifica a janela quando a fonte não sabe dizer.
AGRO_SPRAY_MAX_RAIN_PROBABILITY_PERCENT=30

# --- Segredos futuros — deixe vazio por enquanto ---
# FCM_CREDENTIALS_JSON=
